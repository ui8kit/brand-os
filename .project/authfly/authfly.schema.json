    "shadow": {
      "sm": "0 4px 12px rgba(0,0,0,0.08)",
      "md": "rgba(0,0,0,0.02) 0 0 0 1px, rgba(0,0,0,0.04) 0 2px 6px 0, rgba(0,0,0,0.1) 0 4px 8px 0",
      "lg": "rgba(0,0,0,0.02) 0 0 0 1px, rgba(0,0,0,0.06) 0 8px 16px 0, rgba(0,0,0,0.12) 0 12px 24px 0"
