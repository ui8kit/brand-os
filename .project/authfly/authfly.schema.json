{
  "meta": {
    "name": "Authfly",
    "slug": "authfly",
    "description": "Открытый конструктор аутентификации: self-hosted SAML 2.0 + OIDC IdP, hosted-UI на UI8Kit и адаптивные SDK."
  },
  "brandThesis": {
    "summary": "Auth Fly — открытая аутентификация. На вашей стороне. Сквозная линия — скучная надёжность, безопасность как несущий хребет и контракты раньше кода.",
    "promise": "IdP работает на вашем origin и только на нём. Безопасность ведётся публично.",
    "personality": [
      "confident",
      "reliable",
      "precise",
      "transparent",
      "bold"
    ],
    "antiPersonality": [
      "cluttered",
      "generic-template",
      "opaque",
      "corporate-bland",
      "cheap"
    ],
    "voice": {
      "tone": [
        "clear",
        "confident",
        "direct",
        "transparent"
      ],
      "avoid": [
        "corporate jargon",
        "empty hype",
        "opaque security promises",
        "storytelling instead of facts"
      ]
    }
  },
  "tokens": {
    "color": {
      "light": {
        "background": "#ffffff",
        "foreground": "#222222",
        "primary": "#ff385c",
        "primaryForeground": "#ffffff",
        "secondary": "#f7f7f7",
        "secondaryForeground": "#222222",
        "muted": "#f2f2f2",
        "mutedForeground": "#6a6a6a",
        "accent": "#ff385c",
        "accentForeground": "#ffffff",
        "destructive": "#c13515",
        "destructiveForeground": "#ffffff",
        "border": "#dddddd",
        "input": "#dddddd",
        "ring": "#222222",
        "card": "#ffffff",
        "popover": "#ffffff"
      },
      "dark": {
        "background": "#222222",
        "foreground": "#f7f7f7",
        "primary": "#ff385c",
        "primaryForeground": "#ffffff",
        "card": "#3f3f3f",
        "border": "#6a6a6a",
        "input": "#6a6a6a",
        "secondary": "#3f3f3f",
        "muted": "#3f3f3f",
        "mutedForeground": "#c1c1c1"
      },
      "categories": {
        "plus": {
          "light": "#92174d",
