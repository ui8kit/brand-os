  "designGrammar": {
    "styleDirection": "bold",
    "shapeLanguage": {
      "core": "Confident layout with circular highlights and highly disciplined grayscale."
    },
    "surfaceLanguage": {
      "base": "White canvas with hairline dividers and minimal elevation.",
      "depthRule": "Use 3-layer stacked shadow only for critical floating panels (like booking or auth modals)."
    }
  },
  "tweaks": {
    "defaults": {
      "theme": "dark",
      "accent": "primary",
      "density": "comfortable",
      "radius": "soft",
      "depth": "subtle",
      "motion": "full",
      "typeScale": "default",
      "surfaceTexture": "clean"
    }
  },
  "recipes": {
    "pageArchetypes": {
      "sso-auth": {
        "purpose": "Secure, transparent authentication flow.",
        "requiredSections": [
          "auth-card",
          "sso-options",
          "footer-links"
        ]
      },
      "landing": {
        "purpose": "Communicate open-source values and security.",
        "requiredSections": [
          "hero",
          "values-grid",
          "timeline",
          "technical-books",
          "cta"
        ]
      }
    },
    "sectionArchetypes": {
      "auth-card": {
        "purpose": "Hosted-UI box containing the main login/signup functionality.",
        "requiredSlots": ["logo", "form-fields", "submit-button"],
        "fixedTraits": ["high-elevation shadow", "centered", "max-width-small"]
      },
      "technical-books": {
        "purpose": "Showcase documentation and spec guides.",
        "requiredSlots": ["book-cover", "title", "description", "read-cta"],
        "fixedTraits": ["grid-layout", "hairline-borders"]
      }
    }
  }
}